/* app.wxss 全局样式 */
page {
  background: #f2f3f5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  color: #1f1f1f;
  font-size: 28rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.sec-title {
  margin: 28rpx 28rpx 4rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.muted { color: #999; }

/* 通用按钮 */
.btn-primary {
  background: #07C160;
  color: #fff;
}
.btn-primary[disabled] {
  background: #9ed9b8;
  color: #fff;
}

/* 底部弹出层 */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 50;
}
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 60;
}
