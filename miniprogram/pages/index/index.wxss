/* pages/index/index.wxss */
.header {
  padding: 40rpx 32rpx 8rpx;
  display: flex;
  align-items: baseline;
}
.h-date { font-size: 44rpx; font-weight: 700; color: #1f1f1f; }
.h-week { margin-left: 16rpx; font-size: 28rpx; color: #888; }

.overview {
  display: flex;
  align-items: center;
}
.ov-item { flex: 1; text-align: center; }
.ov-num { font-size: 48rpx; font-weight: 700; color: #07C160; }
.ov-unit { font-size: 28rpx; color: #999; }
.ov-label { font-size: 24rpx; color: #888; margin-top: 4rpx; }
.ov-divider { width: 1rpx; height: 60rpx; background: #eee; }
.ov-stats {
  font-size: 26rpx; color: #07C160;
  padding: 12rpx 20rpx; border: 1rpx solid #07C160;
  border-radius: 999rpx;
}

.study {
  display: flex;
  align-items: center;
}
.study-emoji { font-size: 56rpx; margin-right: 24rpx; }
.study-mid { flex: 1; }
.study-name { font-size: 32rpx; font-weight: 600; }
.study-sub { font-size: 24rpx; color: #07C160; margin-top: 6rpx; }
.study-sub.muted { color: #999; }
.study-flag { font-size: 44rpx; color: #07C160; }
.study-done { background: #f0fbf4; }

.fitness .fit-type { font-size: 32rpx; font-weight: 600; }
.fitness .fit-sub { font-size: 26rpx; color: #666; margin-top: 8rpx; }
.fitness .fit-empty { font-size: 30rpx; color: #07C160; }

.quick {
  margin: 24rpx 24rpx 40rpx;
  text-align: center;
  background: #07C160;
  color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}

/* µ¯²ã±íµ¥ */
.sheet-title { font-size: 32rpx; font-weight: 700; margin-bottom: 16rpx; }
.field {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.field-label { width: 240rpx; color: #555; font-size: 28rpx; }
.field-input { flex: 1; text-align: right; font-size: 28rpx; }
.field-picker { flex: 1; text-align: right; }
.picker-text { color: #07C160; font-size: 28rpx; }
.sheet-btns { display: flex; margin-top: 28rpx; }
.btn-cancel {
  flex: 1; margin-right: 16rpx;
  background: #f2f3f5; color: #333; border-radius: 12rpx;
}
.btn-save {
  flex: 1; margin-left: 16rpx;
  background: #07C160; color: #fff; border-radius: 12rpx;
}
