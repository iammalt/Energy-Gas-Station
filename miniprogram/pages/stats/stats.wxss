/* pages/stats/stats.wxss */
.streak-card { text-align: center; background: linear-gradient(135deg, #07C160, #06a850); color: #fff; }
.streak-num { font-size: 72rpx; font-weight: 800; }
.streak-label { font-size: 28rpx; opacity: 0.9; margin-top: 4rpx; }

.bar-row { display: flex; align-items: center; padding: 16rpx 0; }
.bar-name { width: 180rpx; font-size: 28rpx; }
.bar-bg { flex: 1; height: 20rpx; background: #eee; border-radius: 999rpx; overflow: hidden; margin: 0 16rpx; }
.bar-fill { height: 100%; background: #07C160; border-radius: 999rpx; transition: width .3s; }
.bar-pct { width: 80rpx; text-align: right; font-size: 26rpx; color: #666; }

.trend-row { display: flex; align-items: center; padding: 14rpx 0; }
.trend-label { width: 110rpx; font-size: 26rpx; color: #555; }
.trend-bg { flex: 1; height: 20rpx; background: #eee; border-radius: 999rpx; overflow: hidden; margin: 0 16rpx; }
.trend-fill { height: 100%; background: #576B95; border-radius: 999rpx; transition: width .3s; }
.trend-pct { width: 80rpx; text-align: right; font-size: 26rpx; color: #666; }
