/* pages/week/week.wxss */
.wk-range { font-size: 26rpx; color: #888; text-align: center; }
.wk-summary { text-align: center; margin: 16rpx 0; }
.wk-num { font-size: 56rpx; font-weight: 700; color: #07C160; }
.wk-label { font-size: 24rpx; color: #888; }
.wk-progress {
  height: 16rpx; background: #eee; border-radius: 999rpx; overflow: hidden;
}
.wk-bar { height: 100%; background: #07C160; border-radius: 999rpx; transition: width .3s; }
.wk-fit { text-align: center; font-size: 26rpx; color: #666; margin-top: 16rpx; }

.table { padding: 0; overflow: hidden; }
.tr { display: flex; align-items: center; }
.th { background: #f7f8fa; font-weight: 600; color: #555; }
.tr { border-bottom: 1rpx solid #f2f3f5; }
.td {
  flex: 1; text-align: center; padding: 22rpx 6rpx; font-size: 26rpx;
}
.td-date { font-size: 20rpx; color: #aaa; margin-top: 4rpx; }
