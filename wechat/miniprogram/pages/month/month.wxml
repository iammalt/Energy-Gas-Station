<!-- pages/month/month.wxml 月视图 -->
<view class="page">
  <view class="card">
    <view class="m-title">{{monthText}}</view>
    <view class="m-rate">本月打卡覆盖率 {{rate}}%</view>
    <view class="m-bar-bg"><view class="m-bar" style="width:{{rate}}%"></view></view>
  </view>

  <view class="card cal">
    <view class="cal-week">
      <view class="cw" wx:for="{{weekHead}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="cal-grid">
      <view wx:for="{{cells}}" wx:key="index"
            class="cell {{item.empty ? 'empty' : ''}} {{item.done ? 'done' : ''}}">
        <block wx:if="{{!item.empty}}">
          <view class="cell-day">{{item.day}}</view>
          <view class="cell-rate" wx:if="{{item.done}}">{{item.rate}}%</view>
        </block>
      </view>
    </view>
  </view>
</view>
