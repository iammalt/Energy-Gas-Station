/* pages/month/month.wxss */
.m-title { font-size: 36rpx; font-weight: 700; text-align: center; }
.m-rate { font-size: 26rpx; color: #666; text-align: center; margin: 8rpx 0 16rpx; }
.m-bar-bg { height: 16rpx; background: #eee; border-radius: 999rpx; overflow: hidden; }
.m-bar { height: 100%; background: #07C160; border-radius: 999rpx; transition: width .3s; }

.cal { padding: 20rpx; }
.cal-week { display: flex; margin-bottom: 12rpx; }
.cw { flex: 1; text-align: center; font-size: 24rpx; color: #999; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cell {
  width: 14.28%;
  box-sizing: border-box;
  height: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 12rpx;
}
.cell.empty { visibility: hidden; }
.cell.done { background: #f0fbf4; color: #07C160; }
.cell-rate { font-size: 20rpx; color: #07C160; margin-top: 2rpx; }
