/* pages/wrongbook/wrongbook.wxss */
.filters {
  display: flex;
  padding: 20rpx 16rpx;
  flex-wrap: wrap;
}
.filter {
  padding: 12rpx 28rpx;
  margin: 8rpx 8rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666;
}
.filter.active { background: #07C160; color: #fff; }

.empty-tip { text-align: center; color: #999; font-size: 26rpx; margin: 60rpx 0; }

.item-top { display: flex; align-items: center; justify-content: space-between; }
.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: #fff;
}
.tag-EW { background: #07C160; }
.tag-AI { background: #576B95; }
.tag-SE { background: #F0883E; }
.item-ops { font-size: 26rpx; color: #07C160; }
.op { margin-left: 24rpx; }
.op-del { color: #e54d42; }

.q { font-size: 30rpx; font-weight: 600; margin-top: 12rpx; }
.a { font-size: 26rpx; color: #555; margin-top: 8rpx; }
.r { font-size: 26rpx; color: #999; margin-top: 8rpx; }

.add-btn {
  margin: 24rpx 24rpx 60rpx;
  text-align: center;
  background: #07C160;
  color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.sheet-title { font-size: 32rpx; font-weight: 700; margin-bottom: 16rpx; }
.field {
  display: flex; align-items: center;
  padding: 18rpx 0; border-bottom: 1rpx solid #f0f0f0;
}
.field-col { padding: 18rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.field-label { width: 160rpx; color: #555; font-size: 28rpx; }
.field-picker { flex: 1; text-align: right; }
.picker-text { color: #07C160; font-size: 28rpx; }
.field-area { width: 100%; margin-top: 12rpx; font-size: 28rpx; min-height: 80rpx; }
.sheet-btns { display: flex; margin-top: 28rpx; }
.btn-cancel { flex: 1; margin-right: 16rpx; background: #f2f3f5; color: #333; border-radius: 12rpx; }
.btn-save { flex: 1; margin-left: 16rpx; background: #07C160; color: #fff; border-radius: 12rpx; }
